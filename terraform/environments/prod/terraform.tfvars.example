# Copy to terraform.tfvars (gitignored) and fill in your own values.
# Get subscription_id / tenant_id from: az account show --output json

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

project_name = "ecommerce"
environment  = "prod"
location     = "eastus"

create_terraform_service_principal = true

vnet_cidr         = "10.0.0.0/16"
aks_subnet_cidr   = "10.0.0.0/20"
appgw_subnet_cidr = "10.0.16.0/24"
data_subnet_cidr  = "10.0.17.0/24"
mgmt_subnet_cidr  = "10.0.18.0/24"

# Find yours with: curl -s ifconfig.me   (then append /32)
admin_source_cidr = "203.0.113.5/32"

mgmt_admin_username = "azureadmin"
# Contents of your public key file, e.g.: Get-Content ~/.ssh/id_ed25519.pub
mgmt_ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... you@yourmachine"
mgmt_vm_size         = "Standard_B2s"
